# Copy to .env and adjust. All settings are optional.

# Host port the app is published on
BLOOMERY_PORT=8420

# Session signing key. Leave empty to auto-generate one in ./data/secret.key
BLOOMERY_SECRET_KEY=

# auto = open until the first account exists | true = always open | false = closed
BLOOMERY_ALLOW_REGISTRATION=auto

# Set true when served over HTTPS (reverse proxy)
BLOOMERY_SECURE_COOKIES=false

# ---- AI (optional defaults — easier: set it in the app, Profile → AI assistant) ----
# none | anthropic | openai | openrouter | ollama | custom (any OpenAI-compatible API)
BLOOMERY_AI_PROVIDER=none
# Defaults: ollama -> http://ollama:11434/v1 , openai -> https://api.openai.com/v1 , anthropic -> https://api.anthropic.com
BLOOMERY_AI_BASE_URL=
# Defaults: anthropic -> claude-haiku-4-5-20251001 , openai -> gpt-5-mini , openrouter -> openrouter/auto , ollama -> llama3.2:3b
BLOOMERY_AI_MODEL=
BLOOMERY_AI_API_KEY=
BLOOMERY_AI_TIMEOUT=120
